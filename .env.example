# =============================================================================
# App Home Services - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running the service.
#   cp .env.example .env
# =============================================================================

# -- Database -----------------------------------------------------------------
# PostgreSQL connection string for the app database.
# Format: postgresql://<user>:<password>@<host>/<database>
#
# TLS: append `?sslmode=<mode>` to control transport encryption, e.g.
#   postgresql://user:pass@db.internal/app_home?sslmode=verify-full
# Common modes (libpq / sqlx):
#   disable      -- no TLS; only acceptable for localhost or a fully trusted network
#   prefer       -- (default) try TLS but silently fall back to plaintext; not a
#                   security guarantee
#   require      -- always TLS, but does NOT verify the server certificate, so it
#                   does not protect against man-in-the-middle attacks
#   verify-ca    -- TLS + server certificate must be signed by a trusted CA
#   verify-full  -- TLS + CA check + hostname match; use this for any remote or
#                   production database
DATABASE_URL=postgresql://user:pass@localhost/app_home

# -- Database Connection Pool ---------------------------------------------------
# All of these are optional -- shown here at their actual defaults (i.e. what the
# service uses if you delete/comment out the line). Tune them if you're running
# more than one instance against the same Postgres, or hitting pool exhaustion.
#
# Maximum number of connections this instance's pool will open at once. If you run
# N instances of this service against one Postgres, they together open up to
# N * DB_MAX_CONNECTIONS connections -- make sure that stays comfortably under
# Postgres's own `max_connections` (commonly 100 by default).
DB_MAX_CONNECTIONS=10

# Minimum number of idle connections the pool tries to keep open. 0 means
# connections are opened lazily, on demand, rather than pre-warmed.
DB_MIN_CONNECTIONS=0

# How long (seconds) a request will wait for a connection to free up when the pool
# is fully checked out, before failing with a clear timeout error instead of
# hanging indefinitely.
DB_ACQUIRE_TIMEOUT_SECONDS=30

# How long (seconds) a connection may sit idle in the pool before being closed.
# Set to 0 to disable idle-based recycling (idle connections are never closed).
DB_IDLE_TIMEOUT_SECONDS=600

# Maximum lifetime (seconds) of a single connection before it's closed and
# replaced, regardless of activity -- guards against a connection going silently
# stale behind an intermediary (e.g. a proxy/load balancer in front of Postgres)
# that can drop long-lived connections without either side noticing right away.
# Set to 0 to disable lifetime-based recycling.
DB_MAX_LIFETIME_SECONDS=1800

# Force TLS on the database connection (default: false / unset).
#
# When true, the service rewrites DATABASE_URL to use `sslmode=verify-full`,
# regardless of any `sslmode` value in the connection string itself -- including
# an accidental `sslmode=disable`. Set this in any environment that demands an
# encrypted, certificate-verified connection to Postgres (e.g. production).
#
# Note: `verify-full` requires the server certificate to be signed by a trusted
# CA and its hostname to match, so it will NOT connect to a database presenting
# a self-signed certificate. For local development leave this unset.
#
# Independent of this flag, the service refuses to start if `sslmode=disable` is
# set against a non-loopback database host -- plaintext credentials/data over the
# network are never acceptable. See the TLS notes under DATABASE_URL above.
DB_REQUIRE_SSL=false

# -- Default Local User -------------------------------------------------------
# Credentials for the pre-seeded admin user (auth_provider = 'local').
# This user is created automatically on first startup if it doesn't exist.
DEFAULT_USER_USERNAME=admin
#
# DEFAULT_USER_PASSWORD must be at least 12 characters, contain at least 3 of
# {lowercase, uppercase, digits, symbols}, and not be a known weak/placeholder
# password (e.g. "admin123", "password123", "changeme") -- the service refuses to
# start otherwise. This is the real password for a real, automatically-created
# admin account with a predictable username, so it must not be left weak.
# A password under 16 characters is accepted but logged as a startup warning.
# Generate one with: openssl rand -base64 18
DEFAULT_USER_PASSWORD=<your-secure-password>
DEFAULT_USER_EMAIL=admin@example.com

# -- Google OAuth -------------------------------------------------------------
# OAuth 2.0 Client ID from Google Cloud Console.
# Leave empty to disable Google login.
GOOGLE_CLIENT_ID=<your-google-client-id>

# -- Server -------------------------------------------------------------------
# Host and port the HTTP server will bind to.
# Default if unset: 127.0.0.1 (loopback only, local connections accepted).
# Set to 0.0.0.0 when running in a container or anywhere else the process needs
# to accept connections from outside its own host -- see the README's Container
# Image section: the published image does NOT set this for you, so running it
# without SERVER_HOST=0.0.0.0 starts successfully but is unreachable.
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# -- TLS (optional native HTTPS, see README "HTTPS / TLS") --------------------
# Terminate HTTPS inside the service itself instead of behind a reverse proxy.
# Set BOTH to PEM file paths to enable; setting only one aborts startup. Leave
# both empty to bind plain HTTP (the default), which is expected when a
# TLS-terminating reverse proxy (Caddy, nginx, Traefik, ...) sits in front.
# Example self-signed cert generation: openssl req -x509 -newkey rsa:2048 \
#   -nodes -keyout key.pem -out cert.pem -days 365 -subj "/CN=localhost"
TLS_CERT_PATH=
TLS_KEY_PATH=

# -- JWT ----------------------------------------------------------------------
# Secret key used to sign and verify JWT tokens (access + refresh).
# Must be at least 32 bytes long AND have at least 8 unique characters -- the
# service refuses to start otherwise, since a short or low-diversity secret
# (e.g. "aaaa...aaaa") makes tokens forgeable via brute force against the HS256
# signing key. Generate a strong random key, e.g.: openssl rand -hex 64
JWT_SECRET=<your-jwt-secret>

# `iss` (issuer) claim minted on and required from every token this service
# issues/accepts. Env-configurable so staging and production (or any two
# environments that share a JWT_SECRET) can use distinct values and reject each
# other's tokens -- without this, a token minted in one environment replays in
# the other (see issue #87). Default: app-home-services
JWT_ISSUER=app-home-services

# `aud` (audience) claim minted on and required from every token this service
# issues/accepts. Same rationale as JWT_ISSUER above; set to a value unique to
# this environment. Default: app-home-services
JWT_AUDIENCE=app-home-services

# Access token lifetime in minutes (default: 15).
ACCESS_TOKEN_EXPIRY_MINUTES=15

# Refresh token lifetime in days (default: 7).
REFRESH_TOKEN_EXPIRY_DAYS=7

# bcrypt cost used for password and refresh-token hashing (default: 12, the OWASP
# recommended minimum). Must be between 12 and 31 (bcrypt's maximum) -- the
# service refuses to start otherwise. Higher costs are slower per hash (each +1
# roughly doubles the work), so only raise it if you accept the CPU cost on every
# login/token-refresh. The OWASP floor of 12 is always enforced at startup;
# lower costs are only ever used in direct unit tests (never via this env var).
BCRYPT_COST=12

# -- Rate Limiting ------------------------------------------------------------
# Maximum number of failed login attempts per IP within the time window.
RATE_LIMIT_MAX_ATTEMPTS=10

# Rate limit window in seconds (default: 300 = 5 minutes).
RATE_LIMIT_WINDOW_SECONDS=300

# Redis connection URL used to store rate-limit counters and the access-token
# revocation list (see the "Access token revocation" note below).
#
# Leave empty to use in-memory backends instead -- this is only safe when
# running a single instance of this service, since in-memory state isn't shared
# across restarts or replicas. Set this whenever the service runs behind a load
# balancer with more than one instance, so rate limiting and token revocation
# stay effective.
#
# Formats supported (passed through to the `redis` crate as-is):
#   redis://[:password@]host:port[/db]   -- standard connection, optional auth
#   rediss://[:password@]host:port[/db]  -- TLS-enabled connection
#
# Environment / namespace isolation: rate-limit keys use a fixed prefix
# (ratelimit:login:{ip} / ratelimit:refresh:{ip}) with no environment
# discriminator baked in. If staging and production (or multiple services) ever
# share a single Redis deployment, point each environment at a different logical
# database via the URL's /<db> suffix (e.g. REDIS_URL=redis://host:6379/0 for
# staging, redis://host:6379/1 for production) or, better, use entirely separate
# Redis instances -- otherwise rate-limit counters from different environments
# could collide.
#
# Access token revocation: when REDIS_URL is set, the access-token revocation
# list also lives here (keys acl:revoked:{jti}, TTL = the token's remaining
# lifetime), so logout on one instance revokes the token on every instance. When
# REDIS_URL is empty the revocation list is in-memory (single instance only).
# Unlike rate limiting, an unreachable Redis is NOT fatal at startup here: the
# check fails open, so the service logs a warning and falls back to in-memory.
#
# Example: REDIS_URL=redis://127.0.0.1:6379
# Example with auth: REDIS_URL=redis://:mypassword@127.0.0.1:6379
# Example with TLS: REDIS_URL=rediss://:mypassword@my-redis-host:6380
REDIS_URL=

# How often (seconds) the durable-revocation flush worker retries journaled
# access-token revocations against Redis (default: 5). Only meaningful when
# REDIS_URL is set: when Redis rejects a revoke at logout time, it's journaled
# in Postgres (access_token_revocation_outbox) so the logout still succeeds, and
# this worker re-runs it against Redis until it lands (see issue #140). A lower
# value shrinks the window in which a token logged out during a Redis outage
# still validates on other instances (this instance rejects it immediately); a
# higher value does less work but widens that window.
REVOCATION_FLUSH_INTERVAL_SECONDS=5

# -- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin requests.
# Leave empty to deny all cross-origin access (same-origin only).
CORS_ALLOWED_ORIGINS=

# -- Trusted Proxies ------------------------------------------------------------
# Comma-separated list of IP addresses for reverse proxies / load balancers that
# sit directly in front of this service (e.g. an nginx sidecar, ingress controller,
# or internal load balancer IP).
#
# Only requests whose direct TCP peer address is in this list will have their
# X-Forwarded-For / X-Real-IP headers trusted for rate limiting. Any other request
# has those headers ignored and the real socket peer address is used instead, since
# otherwise any client could spoof these headers to bypass rate limiting entirely.
#
# Leave empty if this service is reached directly (no reverse proxy in front of it).
# Example: TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2
TRUSTED_PROXY_IPS=

# -- Metrics Access -------------------------------------------------------------
# Comma-separated list of IP addresses allowed to reach GET /metrics (e.g. your
# Prometheus server's IP). Resolved the same way as TRUSTED_PROXY_IPS above --
# X-Forwarded-For/X-Real-IP are honored only from a trusted proxy -- so this works
# correctly whether Prometheus reaches this service directly or through a reverse
# proxy.
#
# Leave empty (the default) for no IP restriction -- /metrics is reachable by
# anything that can reach the port, same as before this setting existed. This is
# separate, additional hardening on top of SERVER_HOST defaulting to 127.0.0.1 --
# relevant if you explicitly set SERVER_HOST=0.0.0.0 (e.g. running the container
# image) and want /metrics locked down without a full reverse-proxy/auth setup.
#
# Loopback addresses (127.0.0.1, ::1) are always allowed regardless of this list,
# so local scraping/testing never gets locked out.
# Example: METRICS_ALLOWED_IPS=10.0.0.5,10.0.0.6
METRICS_ALLOWED_IPS=

# -- API Documentation ------------------------------------------------------------
# Serve Swagger UI and the combined OpenAPI spec (default: false / unset).
#
# When true, the service exposes the interactive UI at /swagger-ui and the
# machine-readable spec at /api-docs/openapi.json. These routes list every API
# endpoint, parameter, schema and example, so leaving them on in production lets
# an attacker enumerate the full attack surface (see issue #86). They are
# therefore DISABLED unless explicitly enabled.
#
# For local development: ENABLE_SWAGGER=true
# In any publicly reachable environment: leave unset (false).
ENABLE_SWAGGER=false
